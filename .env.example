# Copie ce fichier en « .env » puis renseigne les valeurs. Ne commite JAMAIS .env.

# --- API de films (TMDB) : https://www.themoviedb.org/settings/api ---
# Clé API (v3, 32 caractères) OU jeton d'accès (v4) : le serveur reconnaît le format.
API_KEY=your_movie_api_key
API_BASE_URL=https://api.themoviedb.org/3

# --- Authentification ---
# 32 caractères minimum. Génération :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secret

# --- Base de données ---
# Docker : mot de passe de la base locale (lettres et chiffres uniquement, pour rester valide dans une URL)
POSTGRES_PASSWORD=your_password
# Neon (production) : décommente et colle l'URL « pooled » de ton dashboard (sslmode=require).
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Facultatif ---
# WEB_PORT=8080
# COOKIE_SECURE=true     # à activer derrière HTTPS
# TRUST_PROXY=1

# --- Développement sans Docker (npm run dev dans server/ et client/) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/cineapp
# CLIENT_ORIGIN=http://localhost:5173
# NODE_ENV=development
